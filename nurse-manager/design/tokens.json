{
  "name": "Nurse AI OS — Manager Edition design tokens",
  "version": "0.1.0",
  "status": "proposed starting tokens — tested for contrast, not yet user-tested",
  "source": "Unified Build Path v0.2, 'Manager experience and visual system'; concept images of 2026-09-27",
  "themes": {
    "day": {
      "canvas": "#F7F5EF",
      "surface": "#FFFFFF",
      "sage": "#DCE5D9",
      "primary": "#173D39",
      "on-primary": "#FFFFFF",
      "text": "#203735",
      "accent-review": "#C65B21",
      "accent-review-text": "#9E4617",
      "focus-ring": "#173D39"
    },
    "night-studio": {
      "canvas": "#10201E",
      "surface": "#1A2E2B",
      "sage": "#1A2E2B",
      "primary": "#8FC1B5",
      "on-primary": "#10201E",
      "text": "#E8EFEA",
      "accent-review": "#F0A071",
      "accent-review-text": "#F0A071",
      "focus-ring": "#8FC1B5"
    }
  },
  "usage_rules": [
    "accent-review (#C65B21) is for non-text accents only — borders, icons, badge fills beside text. It measures 3.92:1 on canvas and 3.3:1 on sage, below the 4.5:1 body-text minimum.",
    "Use accent-review-text for any orange text; it passes 4.5:1 on canvas, sage, and surface.",
    "Color never carries risk or completion alone: every status badge pairs an icon and a text label.",
    "No decorative progress percentages without a defined denominator."
  ],
  "contrast_requirements": [
    {"theme": "day", "fg": "text", "bg": "canvas", "min": 4.5, "use": "body text"},
    {"theme": "day", "fg": "text", "bg": "sage", "min": 4.5, "use": "body text on cards"},
    {"theme": "day", "fg": "text", "bg": "surface", "min": 4.5, "use": "body text on surfaces"},
    {"theme": "day", "fg": "primary", "bg": "canvas", "min": 4.5, "use": "headings and links"},
    {"theme": "day", "fg": "primary", "bg": "sage", "min": 4.5, "use": "navigation text"},
    {"theme": "day", "fg": "on-primary", "bg": "primary", "min": 4.5, "use": "primary button label"},
    {"theme": "day", "fg": "accent-review-text", "bg": "canvas", "min": 4.5, "use": "review label text"},
    {"theme": "day", "fg": "accent-review-text", "bg": "sage", "min": 4.5, "use": "review label on cards"},
    {"theme": "day", "fg": "accent-review", "bg": "canvas", "min": 3.0, "use": "non-text review accent"},
    {"theme": "day", "fg": "accent-review", "bg": "sage", "min": 3.0, "use": "non-text review accent on cards"},
    {"theme": "day", "fg": "focus-ring", "bg": "canvas", "min": 3.0, "use": "focus outline"},
    {"theme": "night-studio", "fg": "text", "bg": "canvas", "min": 4.5, "use": "body text"},
    {"theme": "night-studio", "fg": "text", "bg": "surface", "min": 4.5, "use": "body text on cards"},
    {"theme": "night-studio", "fg": "primary", "bg": "canvas", "min": 4.5, "use": "headings and links"},
    {"theme": "night-studio", "fg": "on-primary", "bg": "primary", "min": 4.5, "use": "primary button label"},
    {"theme": "night-studio", "fg": "accent-review-text", "bg": "surface", "min": 4.5, "use": "review label on cards"},
    {"theme": "night-studio", "fg": "focus-ring", "bg": "surface", "min": 3.0, "use": "focus outline"}
  ],
  "spacing": {"unit_px": 8, "scale": [8, 16, 24, 32, 48, 64]},
  "radius": {"card_px": 12, "card_large_px": 16, "badge_px": 8},
  "typography": {
    "display": {"family": "serif", "note": "serif display headings per concept direction; exact face chosen in G3"},
    "body": {"family": "sans-serif", "min_size_px": 16, "line_height": 1.5}
  },
  "motion": {"respect_reduced_motion": true}
}
