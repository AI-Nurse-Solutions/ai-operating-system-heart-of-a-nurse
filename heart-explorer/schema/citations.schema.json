{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nurse-ai-os.org/heart-explorer/schema/citations.schema.json",
  "title": "Heart Explorer citation registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "authors", "source"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "title": { "type": "string", "minLength": 5 },
      "authors": { "type": "string", "minLength": 2 },
      "source": { "type": "string", "minLength": 2 },
      "year": { "type": "integer", "minimum": 1900 },
      "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
      "url": { "type": "string", "pattern": "^https://" }
    },
    "anyOf": [{ "required": ["doi"] }, { "required": ["url"] }]
  }
}
