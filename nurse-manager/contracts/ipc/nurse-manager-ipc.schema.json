{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurse-ai-os.local/contracts/nurse-manager-ipc@1.schema.json",
  "title": "Nurse Manager IPC contract, version 1",
  "description": "Every message the manager core sends to the desktop host. Each CLI command prints one Envelope; commands.json names the data type for each command. TypeScript types in nurse-manager-ipc.d.ts are generated from this file.",
  "$defs": {
    "Contract": {"const": "nurse-manager-ipc@1"},
    "IsoDate": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "IsoDateTime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([+-][0-9]{2}:[0-9]{2}|Z)$"},
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "RecordId": {"type": "string", "pattern": "^(ws|prj|tsk|dec|src|pri|art|rev|act|air|note|fbk|lrn|ctb)-[0-9a-f]{12}$"},
    "TaskStatus": {"enum": ["idea", "ready", "in_progress", "needs_judgment", "completed"]},
    "SectionState": {"enum": ["ok", "empty"]},

    "OkEnvelope": {
      "type": "object",
      "properties": {
        "contract": {"$ref": "#/$defs/Contract"},
        "command": {"type": "string"},
        "ok": {"const": true},
        "data": {"type": "object"}
      },
      "required": ["contract", "command", "ok", "data"],
      "additionalProperties": false
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "contract": {"$ref": "#/$defs/Contract"},
        "command": {"type": "string"},
        "ok": {"const": false},
        "error": {"$ref": "#/$defs/IpcError"}
      },
      "required": ["contract", "command", "ok", "error"],
      "additionalProperties": false
    },
    "IpcError": {
      "description": "A truthful failure. The message is written for the manager; type names the error class.",
      "type": "object",
      "properties": {"type": {"type": "string"}, "message": {"type": "string"}},
      "required": ["type", "message"],
      "additionalProperties": false
    },

    "Workspace": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "name": {"type": "string"},
        "owner": {"type": "string"},
        "profile": {"const": "personal_manager"},
        "sample": {"type": "boolean", "description": "True for the synthetic sample workspace; every view must say so."}
      },
      "required": ["id", "name", "owner", "profile", "sample"],
      "additionalProperties": false
    },
    "SampleResult": {
      "type": "object",
      "properties": {
        "workspace": {"$ref": "#/$defs/Workspace"},
        "week_of": {"$ref": "#/$defs/IsoDate"},
        "today": {"$ref": "#/$defs/IsoDate"}
      },
      "required": ["workspace", "week_of", "today"],
      "additionalProperties": false
    },

    "Priority": {
      "type": "object",
      "properties": {
        "rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "text": {"type": "string"},
        "project_id": {"anyOf": [{"$ref": "#/$defs/RecordId"}, {"type": "null"}]}
      },
      "required": ["rank", "text", "project_id"],
      "additionalProperties": false
    },
    "JudgmentItem": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["task", "draft", "action"]},
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "owner": {"type": "string", "description": "Present for tasks only."}
      },
      "required": ["kind", "id", "title"],
      "additionalProperties": false
    },
    "ProjectSummary": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "owner": {"type": "string"},
        "next_milestone": {"type": "string"},
        "open_tasks": {"type": "integer", "minimum": 0},
        "completed_tasks": {"type": "integer", "minimum": 0},
        "blocked_tasks": {"type": "integer", "minimum": 0}
      },
      "required": ["id", "title", "owner", "next_milestone", "open_tasks", "completed_tasks", "blocked_tasks"],
      "additionalProperties": false
    },
    "FollowUp": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "owner": {"type": "string"},
        "due_date": {"$ref": "#/$defs/IsoDate"},
        "overdue": {"type": "boolean"}
      },
      "required": ["id", "title", "owner", "due_date", "overdue"],
      "additionalProperties": false
    },
    "AcceptedOutput": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "accepted_by": {"type": "string"},
        "accepted_at": {"$ref": "#/$defs/IsoDateTime"}
      },
      "required": ["id", "title", "accepted_by", "accepted_at"],
      "additionalProperties": false
    },
    "PrioritiesSection": {
      "type": "object",
      "properties": {
        "state": {"$ref": "#/$defs/SectionState"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Priority"}, "maxItems": 3},
        "empty_message": {"type": "string"}
      },
      "required": ["state", "items", "empty_message"],
      "additionalProperties": false
    },
    "JudgmentSection": {
      "type": "object",
      "properties": {
        "state": {"$ref": "#/$defs/SectionState"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/JudgmentItem"}},
        "empty_message": {"type": "string"}
      },
      "required": ["state", "items", "empty_message"],
      "additionalProperties": false
    },
    "ProjectsSection": {
      "type": "object",
      "properties": {
        "state": {"$ref": "#/$defs/SectionState"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ProjectSummary"}},
        "empty_message": {"type": "string"}
      },
      "required": ["state", "items", "empty_message"],
      "additionalProperties": false
    },
    "FollowUpsSection": {
      "type": "object",
      "properties": {
        "state": {"$ref": "#/$defs/SectionState"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/FollowUp"}},
        "empty_message": {"type": "string"}
      },
      "required": ["state", "items", "empty_message"],
      "additionalProperties": false
    },
    "AcceptedOutputsSection": {
      "type": "object",
      "properties": {
        "state": {"$ref": "#/$defs/SectionState"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/AcceptedOutput"}, "maxItems": 5},
        "empty_message": {"type": "string"}
      },
      "required": ["state", "items", "empty_message"],
      "additionalProperties": false
    },
    "AssistantsSection": {
      "description": "No assistant runtime exists yet; the section is honestly unavailable.",
      "type": "object",
      "properties": {
        "state": {"const": "unavailable"},
        "items": {"type": "array", "maxItems": 0},
        "empty_message": {"type": "string"}
      },
      "required": ["state", "items", "empty_message"],
      "additionalProperties": false
    },
    "TaskCounts": {
      "type": "object",
      "properties": {
        "idea": {"type": "integer", "minimum": 0},
        "ready": {"type": "integer", "minimum": 0},
        "in_progress": {"type": "integer", "minimum": 0},
        "needs_judgment": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0}
      },
      "required": ["idea", "ready", "in_progress", "needs_judgment", "completed"],
      "additionalProperties": false
    },
    "MissionControl": {
      "description": "What needs my attention? Every section reads the same records as the board and table.",
      "type": "object",
      "properties": {
        "workspace": {"type": "string"},
        "sample": {"type": "boolean"},
        "today": {"$ref": "#/$defs/IsoDate"},
        "week_of": {"$ref": "#/$defs/IsoDate"},
        "priorities": {"$ref": "#/$defs/PrioritiesSection"},
        "needs_my_judgment": {"$ref": "#/$defs/JudgmentSection"},
        "projects_in_motion": {"$ref": "#/$defs/ProjectsSection"},
        "follow_ups": {"$ref": "#/$defs/FollowUpsSection"},
        "assistants_at_work": {"$ref": "#/$defs/AssistantsSection"},
        "recent_accepted_outputs": {"$ref": "#/$defs/AcceptedOutputsSection"},
        "task_counts": {"$ref": "#/$defs/TaskCounts"}
      },
      "required": ["workspace", "sample", "today", "week_of", "priorities", "needs_my_judgment",
                   "projects_in_motion", "follow_ups", "assistants_at_work",
                   "recent_accepted_outputs", "task_counts"],
      "additionalProperties": false
    },

    "ProjectSummaryHeader": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "purpose": {"type": "string"},
        "owner": {"type": "string", "description": "The accountable owner."},
        "next_milestone": {"type": "string"},
        "status": {"enum": ["active", "paused", "completed"]}
      },
      "required": ["id", "title", "purpose", "owner", "next_milestone", "status"],
      "additionalProperties": false
    },
    "Readiness": {
      "description": "Stated facts about readiness. Deliberately not a score or a percentage.",
      "type": "object",
      "properties": {
        "has_next_milestone": {"type": "boolean"},
        "open_tasks": {"type": "integer", "minimum": 0},
        "completed_tasks": {"type": "integer", "minimum": 0},
        "blocked_tasks": {"type": "integer", "minimum": 0},
        "needs_judgment": {"type": "integer", "minimum": 0},
        "overdue_tasks": {"type": "integer", "minimum": 0},
        "tasks_without_next_action": {"type": "integer", "minimum": 0, "description": "Ready or in-progress tasks with no next action written down."},
        "open_feedback": {"type": "integer", "minimum": 0, "description": "Feedback not yet addressed."}
      },
      "required": ["has_next_milestone", "open_tasks", "completed_tasks", "blocked_tasks", "needs_judgment", "overdue_tasks", "tasks_without_next_action", "open_feedback"],
      "additionalProperties": false
    },
    "Feedback": {
      "description": "Feedback about a project's work, from a group or role. Never about a named person or anyone's performance. Addressed means a response was written.",
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "from_group": {"type": "string"},
        "kind": {"enum": ["worked", "change", "question"]},
        "summary": {"type": "string"},
        "received_on": {"$ref": "#/$defs/IsoDate"},
        "status": {"enum": ["open", "addressed"]},
        "response": {"type": "string"},
        "addressed_on": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]}
      },
      "required": ["id", "from_group", "kind", "summary", "received_on", "status", "response", "addressed_on"],
      "additionalProperties": false
    },
    "FeedbackResult": {
      "type": "object",
      "properties": {"feedback": {"$ref": "#/$defs/Feedback"}},
      "required": ["feedback"],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "question": {"type": "string"},
        "decision": {"type": "string"},
        "decided_by": {"type": "string"},
        "decided_on": {"$ref": "#/$defs/IsoDate"},
        "rationale": {"type": "string"}
      },
      "required": ["id", "question", "decision", "decided_by", "decided_on", "rationale"],
      "additionalProperties": false
    },
    "Resource": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "kind": {"enum": ["public", "synthetic", "personal_permitted"]},
        "reference": {"type": "string"},
        "review_date": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]},
        "review_overdue": {"type": "boolean"}
      },
      "required": ["id", "title", "kind", "reference", "review_date", "review_overdue"],
      "additionalProperties": false
    },
    "ContributionItem": {
      "description": "One of the manager's contributions and who shares the credit. Verified means the manager wrote the evidence that shows it happened.",
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "kind": {"enum": ["improvement", "teaching", "committee", "presentation", "publication"]},
        "occurred_on": {"$ref": "#/$defs/IsoDate"},
        "my_part": {"type": "string"},
        "shared_credit": {"type": "string", "description": "Teams, groups or roles; never a ranking of named colleagues."},
        "project_id": {"anyOf": [{"$ref": "#/$defs/RecordId"}, {"type": "null"}]},
        "project_title": {"type": ["string", "null"]},
        "status": {"enum": ["draft", "verified"]},
        "evidence": {"type": "string"},
        "verified_on": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]}
      },
      "required": ["id", "title", "kind", "occurred_on", "my_part", "shared_credit", "project_id", "project_title", "status", "evidence", "verified_on"],
      "additionalProperties": false
    },
    "Contributions": {
      "description": "Contributions: drafts awaiting evidence, then verified, newest first. Stated facts, never a score or a ranking.",
      "type": "object",
      "properties": {
        "sample": {"type": "boolean"},
        "today": {"$ref": "#/$defs/IsoDate"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ContributionItem"}},
        "drafts": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "this_year_verified": {"type": "integer", "minimum": 0, "description": "Verified contributions that happened in the calendar year of today, whenever they were verified."},
        "projects": {
          "description": "Projects a new contribution can be linked to.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"id": {"$ref": "#/$defs/RecordId"}, "title": {"type": "string"}},
            "required": ["id", "title"],
            "additionalProperties": false
          }
        }
      },
      "required": ["sample", "today", "items", "drafts", "verified", "this_year_verified", "projects"],
      "additionalProperties": false
    },
    "ContributionResult": {
      "type": "object",
      "properties": {"item": {"$ref": "#/$defs/ContributionItem"}},
      "required": ["item"],
      "additionalProperties": false
    },
    "LearningItem": {
      "description": "One piece of the manager's own professional learning. Completed means a takeaway and a date were written.",
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "kind": {"enum": ["course", "reading", "conference", "certification", "mentoring"]},
        "status": {"enum": ["planned", "in_progress", "completed"]},
        "target_date": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]},
        "hours": {"type": ["number", "null"], "minimum": 0, "maximum": 500},
        "takeaway": {"type": "string"},
        "completed_on": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]}
      },
      "required": ["id", "title", "kind", "status", "target_date", "hours", "takeaway", "completed_on"],
      "additionalProperties": false
    },
    "Learning": {
      "description": "Learning and Growth: in progress, planned, then completed. Stated facts, never a score.",
      "type": "object",
      "properties": {
        "sample": {"type": "boolean"},
        "today": {"$ref": "#/$defs/IsoDate"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/LearningItem"}},
        "in_progress": {"type": "integer", "minimum": 0},
        "planned": {"type": "integer", "minimum": 0},
        "completed_this_year": {"type": "integer", "minimum": 0},
        "hours_this_year": {"type": "number", "minimum": 0},
        "past_target": {"type": "integer", "minimum": 0, "description": "Not completed and past its target date."}
      },
      "required": ["sample", "today", "items", "in_progress", "planned", "completed_this_year", "hours_this_year", "past_target"],
      "additionalProperties": false
    },
    "LearningResult": {
      "type": "object",
      "properties": {"item": {"$ref": "#/$defs/LearningItem"}},
      "required": ["item"],
      "additionalProperties": false
    },
    "LibraryItem": {
      "description": "One source in the workspace. The reference is shown as text, never opened by the app.",
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "kind": {"enum": ["public", "synthetic", "personal_permitted"]},
        "reference": {"type": "string"},
        "data_class": {"enum": ["D0", "D1"]},
        "project_id": {"anyOf": [{"$ref": "#/$defs/RecordId"}, {"type": "null"}]},
        "project": {"type": ["string", "null"]},
        "review_date": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]},
        "review_overdue": {"type": "boolean"}
      },
      "required": ["id", "title", "kind", "reference", "data_class", "project_id", "project", "review_date", "review_overdue"],
      "additionalProperties": false
    },
    "Library": {
      "description": "Every source in the workspace, overdue reviews first.",
      "type": "object",
      "properties": {
        "sample": {"type": "boolean"},
        "today": {"$ref": "#/$defs/IsoDate"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/LibraryItem"}},
        "review_overdue": {"type": "integer", "minimum": 0},
        "projects": {
          "description": "Projects a new source can belong to.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {"id": {"$ref": "#/$defs/RecordId"}, "title": {"type": "string"}},
            "required": ["id", "title"],
            "additionalProperties": false
          }
        }
      },
      "required": ["sample", "today", "items", "review_overdue", "projects"],
      "additionalProperties": false
    },
    "SourceResult": {
      "type": "object",
      "properties": {"source": {"$ref": "#/$defs/LibraryItem"}},
      "required": ["source"],
      "additionalProperties": false
    },
    "EvidenceItem": {
      "type": "object",
      "properties": {
        "task_id": {"$ref": "#/$defs/RecordId"},
        "task": {"type": "string"},
        "evidence": {"type": "string"}
      },
      "required": ["task_id", "task", "evidence"],
      "additionalProperties": false
    },
    "ProjectDashboard": {
      "description": "What will move this initiative forward? Tasks use the same rows and ids as the table.",
      "type": "object",
      "properties": {
        "sample": {"type": "boolean"},
        "today": {"$ref": "#/$defs/IsoDate"},
        "project": {"$ref": "#/$defs/ProjectSummaryHeader"},
        "readiness": {"$ref": "#/$defs/Readiness"},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/TableRow"}},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/Decision"}},
        "resources": {"type": "array", "items": {"$ref": "#/$defs/Resource"}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/EvidenceItem"}},
        "feedback": {"type": "array", "items": {"$ref": "#/$defs/Feedback"}, "description": "Open feedback first, then addressed; newest first within each."},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/ProjectNote"}, "description": "AI answers the manager chose to keep, newest first."}
      },
      "required": ["sample", "today", "project", "readiness", "tasks", "decisions", "resources", "evidence", "feedback", "notes"],
      "additionalProperties": false
    },
    "BoardCard": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "title": {"type": "string"},
        "owner": {"type": "string"},
        "due_date": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]},
        "project": {"type": ["string", "null"]},
        "blocked": {"type": "boolean"},
        "blocked_reason": {"type": "string"},
        "paused": {"type": "boolean"}
      },
      "required": ["id", "title", "owner", "due_date", "project", "blocked", "blocked_reason", "paused"],
      "additionalProperties": false
    },
    "BoardColumn": {
      "type": "object",
      "properties": {
        "status": {"$ref": "#/$defs/TaskStatus"},
        "label": {"type": "string"},
        "count": {"type": "integer", "minimum": 0},
        "cards": {"type": "array", "items": {"$ref": "#/$defs/BoardCard"}}
      },
      "required": ["status", "label", "count", "cards"],
      "additionalProperties": false
    },
    "Board": {
      "type": "object",
      "properties": {
        "sample": {"type": "boolean"},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/BoardColumn"}, "minItems": 5, "maxItems": 5}
      },
      "required": ["sample", "columns"],
      "additionalProperties": false
    },
    "TableRow": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "task": {"type": "string"},
        "project": {"type": ["string", "null"]},
        "owner": {"type": "string"},
        "due_date": {"anyOf": [{"$ref": "#/$defs/IsoDate"}, {"type": "null"}]},
        "status": {"$ref": "#/$defs/TaskStatus"},
        "blocked": {"type": "boolean"},
        "paused": {"type": "boolean"},
        "reviewer": {"type": "string"},
        "evidence": {"type": "string"},
        "next_action": {"type": "string"}
      },
      "required": ["id", "task", "project", "owner", "due_date", "status", "blocked", "paused",
                   "reviewer", "evidence", "next_action"],
      "additionalProperties": false
    },
    "Table": {
      "type": "object",
      "properties": {
        "sample": {"type": "boolean"},
        "columns": {
          "type": "array",
          "items": {"enum": ["task", "project", "owner", "due_date", "status", "reviewer", "evidence", "next_action"]}
        },
        "rows": {"type": "array", "items": {"$ref": "#/$defs/TableRow"}}
      },
      "required": ["sample", "columns", "rows"],
      "additionalProperties": false
    },

    "Revision": {
      "description": "One revision of a brief. Accepted means a human accepted exactly this text (sha256).",
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "artifact_id": {"$ref": "#/$defs/RecordId"},
        "revision_no": {"type": "integer", "minimum": 1},
        "status": {"enum": ["draft", "accepted", "superseded"]},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/RecordId"}},
        "created_by": {"type": "string", "minLength": 1, "description": "Who wrote this text: the manager, or assistant:<provider> for a model's draft."},
        "accepted_by": {"type": ["string", "null"]},
        "accepted_at": {"anyOf": [{"$ref": "#/$defs/IsoDateTime"}, {"type": "null"}]}
      },
      "required": ["id", "artifact_id", "revision_no", "status", "sha256", "source_refs", "created_by", "accepted_by", "accepted_at"],
      "additionalProperties": false
    },
    "WeeklyBrief": {
      "description": "One week's brief: the newest revision, rendered with its status banner, and the accepted revision if there is one.",
      "type": "object",
      "properties": {
        "week_of": {"$ref": "#/$defs/IsoDate"},
        "current": {"anyOf": [{"$ref": "#/$defs/ShownRevision"}, {"type": "null"}]},
        "accepted": {"anyOf": [{"$ref": "#/$defs/Revision"}, {"type": "null"}]}
      },
      "required": ["week_of", "current", "accepted"],
      "additionalProperties": false
    },
    "ShownRevision": {
      "type": "object",
      "properties": {
        "revision": {"$ref": "#/$defs/Revision"},
        "markdown": {"type": "string", "description": "The only rendering; it always carries its status banner."}
      },
      "required": ["revision", "markdown"],
      "additionalProperties": false
    },

    "Action": {
      "description": "A governed action. Draft ready, accepted, exported, and sent are distinct states.",
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "origin": {"enum": ["human", "assistant"]},
        "proposed_by": {"type": "string"},
        "effect": {"type": "string"},
        "purpose": {"type": "string"},
        "artifact_revision_id": {"anyOf": [{"$ref": "#/$defs/RecordId"}, {"type": "null"}]},
        "payload_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"},
        "destination": {"type": "string"},
        "cost_limit_cents": {"type": "integer", "minimum": 0},
        "expected_effect": {"type": "string"},
        "tier": {"enum": ["green", "yellow", "red"]},
        "policy_decision": {"enum": ["allow", "require_approval", "deny"]},
        "policy_reasons": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["denied", "awaiting_approval", "approved", "executing", "succeeded", "failed", "effect_unknown", "stale"]}
      },
      "required": ["id", "origin", "proposed_by", "effect", "purpose", "artifact_revision_id", "payload_sha256",
                   "destination", "cost_limit_cents", "expected_effect", "tier", "policy_decision",
                   "policy_reasons", "status"],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "action_id": {"$ref": "#/$defs/RecordId"},
        "outcome": {"enum": ["succeeded", "failed", "effect_unknown"]},
        "detail": {"type": "string"},
        "recorded_at": {"$ref": "#/$defs/IsoDateTime"}
      },
      "required": ["action_id", "outcome", "detail", "recorded_at"],
      "additionalProperties": false
    },
    "BackupResult": {
      "type": "object",
      "properties": {"backup": {"type": "string"}},
      "required": ["backup"],
      "additionalProperties": false
    },
    "RestoreResult": {
      "type": "object",
      "properties": {
        "restored_from": {"type": "string"},
        "pre_restore_backup": {"type": "string", "description": "Always taken, so even an accepted discard is recoverable."}
      },
      "required": ["restored_from", "pre_restore_backup"],
      "additionalProperties": false
    },

    "AssistantProvider": {
      "description": "The connected AI provider. 'none' is the default (ADR 0004). There is no cloud value until a cloud service is chosen.",
      "enum": ["none", "local"]
    },
    "AssistantStatus": {
      "description": "AI settings, usage so far, and the gates every provider passes.",
      "type": "object",
      "properties": {
        "provider": {"$ref": "#/$defs/AssistantProvider"},
        "model": {"type": "string"},
        "endpoint": {"type": "string"},
        "runs_on": {"type": "string", "description": "Where the text goes, said plainly."},
        "monthly_budget_cents": {"type": "integer", "minimum": 0},
        "daily_request_limit": {"type": "integer", "minimum": 0},
        "requests_today": {"type": "integer", "minimum": 0},
        "spent_this_month_cents": {"type": "integer", "minimum": 0},
        "cloud": {
          "type": "object",
          "properties": {"available": {"type": "boolean"}, "reason": {"type": "string"}},
          "required": ["available", "reason"],
          "additionalProperties": false
        },
        "gates": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      },
      "required": ["provider", "model", "endpoint", "runs_on", "monthly_budget_cents", "daily_request_limit", "requests_today", "spent_this_month_cents", "cloud", "gates"],
      "additionalProperties": false
    },
    "AssistantCheck": {
      "description": "One gate that runs before anything is sent.",
      "type": "object",
      "properties": {
        "gate": {"enum": ["data_rules", "edena", "budget"]},
        "passed": {"type": "boolean"},
        "detail": {"type": "string", "description": "Written for the manager."}
      },
      "required": ["gate", "passed", "detail"],
      "additionalProperties": false
    },
    "AssistantPreview": {
      "description": "Exactly what asking the model would send, and the gates' verdicts. Nothing is sent to produce it. With no model connected, system and prompt are empty and will_send is false.",
      "type": "object",
      "properties": {
        "week_of": {"$ref": "#/$defs/IsoDate"},
        "provider": {"$ref": "#/$defs/AssistantProvider"},
        "model": {"type": "string"},
        "runs_on": {"type": "string"},
        "system": {"type": "string", "description": "The instructions sent to the model."},
        "prompt": {"type": "string", "description": "The record text sent to the model."},
        "prompt_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"const": ""}], "description": "Send it back with assistant-brief; a change since the preview refuses the request."},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/AssistantCheck"}},
        "will_send": {"type": "boolean"},
        "reason": {"type": "string", "description": "Why nothing would be sent. Empty when will_send is true."}
      },
      "required": ["week_of", "provider", "model", "runs_on", "system", "prompt", "prompt_sha256", "checks", "will_send", "reason"],
      "additionalProperties": false
    },
    "ProjectQuestionPreview": {
      "description": "Exactly what asking the model about one project would send, and the gates' verdicts. Nothing is sent to produce it. With no model connected, system and prompt are empty and will_send is false.",
      "type": "object",
      "properties": {
        "project_id": {"$ref": "#/$defs/RecordId"},
        "provider": {"$ref": "#/$defs/AssistantProvider"},
        "model": {"type": "string"},
        "runs_on": {"type": "string"},
        "system": {"type": "string", "description": "The instructions sent to the model."},
        "prompt": {"type": "string", "description": "The question and the project's record text sent to the model."},
        "prompt_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"const": ""}], "description": "Send it back with assistant-project; a change since the preview refuses the request."},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/AssistantCheck"}},
        "will_send": {"type": "boolean"},
        "reason": {"type": "string", "description": "Why nothing would be sent. Empty when will_send is true."}
      },
      "required": ["project_id", "provider", "model", "runs_on", "system", "prompt", "prompt_sha256", "checks", "will_send", "reason"],
      "additionalProperties": false
    },
    "ProjectAnswer": {
      "description": "The answer to a question about one project. It is a suggestion shown to the manager and is never saved; the ledger keeps only metadata.",
      "type": "object",
      "properties": {
        "outcome": {"enum": ["answered", "no_model", "refused_data_rules", "refused_policy", "refused_budget", "provider_failed", "output_refused"]},
        "answered_by_model": {"type": "boolean"},
        "reason": {"type": "string", "description": "Written for the manager. Empty only when the model answered."},
        "provider": {"$ref": "#/$defs/AssistantProvider"},
        "model": {"type": "string"},
        "request_id": {"$ref": "#/$defs/RecordId"},
        "project_id": {"$ref": "#/$defs/RecordId"},
        "question": {"type": "string", "description": "The question as asked, whitespace normalized. Send it back with note-keep."},
        "answer": {"type": "string", "description": "Markdown with record citations; empty unless the model answered."},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/RecordId"}}
      },
      "required": ["outcome", "answered_by_model", "reason", "provider", "model", "request_id", "project_id", "question", "answer", "source_refs"],
      "additionalProperties": false
    },
    "ProjectNote": {
      "description": "An AI answer the manager kept. Its text is exactly what the model answered (proven by the hash the request ledger recorded), and keeping it was the manager's acceptance.",
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/RecordId"},
        "project_id": {"$ref": "#/$defs/RecordId"},
        "request_id": {"$ref": "#/$defs/RecordId"},
        "question": {"type": "string"},
        "body_markdown": {"type": "string"},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/RecordId"}},
        "written_by": {"type": "string", "description": "assistant:<provider>"},
        "model": {"type": "string"},
        "kept_by": {"type": "string"},
        "kept_at": {"$ref": "#/$defs/IsoDateTime"}
      },
      "required": ["id", "project_id", "request_id", "question", "body_markdown", "sha256", "source_refs", "written_by", "model", "kept_by", "kept_at"],
      "additionalProperties": false
    },
    "AssistantOutcome": {
      "description": "What happened to one request. Every outcome except 'drafted' returns the draft composed from records.",
      "enum": ["drafted", "no_model", "refused_data_rules", "refused_policy", "refused_budget", "provider_failed", "output_refused"]
    },
    "AssistantDraft": {
      "description": "The answer to asking for an AI draft of the weekly brief. The revision is always a draft; drafted_by_model says whether a model wrote it.",
      "type": "object",
      "properties": {
        "outcome": {"$ref": "#/$defs/AssistantOutcome"},
        "drafted_by_model": {"type": "boolean"},
        "reason": {"type": "string", "description": "Written for the manager. Empty only when a model drafted it."},
        "provider": {"$ref": "#/$defs/AssistantProvider"},
        "model": {"type": "string"},
        "request_id": {"$ref": "#/$defs/RecordId"},
        "revision": {"$ref": "#/$defs/Revision"}
      },
      "required": ["outcome", "drafted_by_model", "reason", "provider", "model", "request_id", "revision"],
      "additionalProperties": false
    }
  }
}
