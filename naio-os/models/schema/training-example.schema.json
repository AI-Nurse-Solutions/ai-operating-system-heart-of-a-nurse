{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurseai.solutions/naio-os/models/schema/training-example.schema.json",
  "title": "NAIO training example",
  "description": "One governed fine-tuning record. Every enum here is drawn from naio-os/config/edena-policy.yaml v2.0.0 or naio-os/mission-control/roles/. A record may not introduce governance vocabulary the runtime cannot enforce.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "example_id",
    "dataset_version",
    "task",
    "origin",
    "role_id",
    "sphere",
    "input",
    "ideal_response",
    "review_status",
    "trained_against"
  ],
  "properties": {
    "example_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable identifier. Never reused, never renamed."
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "trained_against": {
      "type": "string",
      "pattern": "^edena-policy@\\d+\\.\\d+\\.\\d+$",
      "description": "The policy version this record's governance fields were written against. A record outliving its policy version is stale, not wrong-by-default, and is re-reviewed rather than silently reused."
    },
    "task": {
      "enum": [
        "workflow_spec",
        "triage_justification",
        "critique",
        "refusal_redirect"
      ]
    },
    "origin": {
      "enum": [
        "nurse_authored",
        "synthetic",
        "harvested"
      ],
      "description": "harvested = sampled from a prior checkpoint for preference ranking."
    },
    "role_id": {
      "enum": [
        "bedside",
        "charge",
        "student",
        "educator",
        "leader",
        "np",
        "resident",
        "entrepreneur"
      ],
      "description": "Matches naio-os/mission-control/roles/. Informational: it never raises a ceiling."
    },
    "sphere": {
      "enum": [
        "personal",
        "professional",
        "community",
        "sidegig",
        "interest"
      ]
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "effective_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "Provenance for any grounded claim the ideal response makes. florence-x requires every retrieved fact to carry its source."
    },
    "ideal_response": {
      "type": "string",
      "minLength": 1
    },
    "rejected_response": {
      "type": "string",
      "description": "Populated only for preference records, and only when harvested from a checkpoint. Hand-written strawmen are not preference data."
    },
    "expected_classification": {
      "type": "object",
      "description": "What the model should PROPOSE. The deterministic policy evaluator computes the authoritative gate from these inputs; the model never asserts the gate as fact.",
      "additionalProperties": false,
      "properties": {
        "tool_classes": {
          "type": "array",
          "items": {
            "enum": [
              "read_only",
              "draft_local",
              "external_reversible",
              "external_irreversible",
              "code_execution",
              "delegation"
            ]
          }
        },
        "reversibility": {
          "enum": [
            "reversible",
            "recoverable",
            "irreversible"
          ]
        },
        "hard_boundaries_implicated": {
          "type": "array",
          "items": {
            "enum": [
              "no_phi",
              "no_clinical_decisions",
              "human_agency",
              "license_respect",
              "confidentiality",
              "data_withdrawal",
              "transparency",
              "health_equity"
            ]
          }
        },
        "prohibited_practices_implicated": {
          "type": "array",
          "items": {
            "enum": [
              "manipulation",
              "vulnerability_exploitation",
              "social_scoring",
              "surveillance_emotion_inference",
              "untargeted_biometric_scraping",
              "autonomous_care"
            ]
          }
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Each entry cites the policy clause it rests on."
        }
      }
    },
    "expected_gate": {
      "enum": [
        "every-output",
        "before-external-use",
        "forced-irreversible",
        "scoped-checkpoint",
        "post-hoc-audit"
      ],
      "description": "The gate the policy evaluator computes for this record. Recorded for scoring gate 2, never generated by the model as authority."
    },
    "uncertainty_expected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What a correct response must admit it does not know."
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Identifiers of the humans who reviewed this record. An approved record with no reviewer is rejected."
    },
    "review_status": {
      "enum": [
        "draft",
        "reviewed",
        "approved"
      ]
    },
    "split": {
      "enum": [
        "train",
        "eval_frozen",
        "injection_suite"
      ],
      "description": "eval_frozen and injection_suite records are sealed before training and never trained on."
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "reviewers"
        ],
        "title": "an approved record must name the humans who reviewed it"
      }
    },
    {
      "if": {
        "properties": {
          "rejected_response": {
            "type": "string"
          }
        },
        "required": [
          "rejected_response"
        ]
      },
      "then": {
        "properties": {
          "origin": {
            "const": "harvested",
            "title": "preference pairs come from a checkpoint, not from an authored strawman"
          }
        }
      }
    }
  ]
}
