{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nurse-ai-os.org/heart-explorer/schema/heart-card.schema.json",
  "title": "Heart Explorer card",
  "description": "One node of the Heart Explorer knowledge graph. Educational content only: no patient data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "label", "summary", "relations", "review"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable id. Matches the file name, and for structures the mesh name in the 3D model."
    },
    "type": {
      "enum": ["structure", "dysfunction", "syndrome", "finding", "drug", "intervention", "device"]
    },
    "label": { "type": "string", "minLength": 2, "maxLength": 80 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 600,
      "description": "Two or three plain sentences written for a bedside nurse."
    },
    "levers": {
      "type": "array",
      "items": { "$ref": "#/definitions/leverEffect" }
    },
    "nursingPriorities": {
      "type": "array",
      "items": { "type": "string", "minLength": 20, "maxLength": 300 }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/definitions/relation" }
    },
    "citations": { "$ref": "#/definitions/citationIds" },
    "review": { "$ref": "#/definitions/review" }
  },
  "definitions": {
    "citationIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "leverEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lever", "effect", "why", "citations"],
      "properties": {
        "lever": {
          "enum": ["preload", "afterload", "contractility", "heart-rate", "rhythm", "o2-supply", "o2-demand"]
        },
        "effect": { "enum": ["increase", "decrease"] },
        "why": { "type": "string", "minLength": 20, "maxLength": 300 },
        "citations": { "$ref": "#/definitions/citationIds" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rel", "target", "why", "citations"],
      "properties": {
        "rel": {
          "enum": [
            "located_in",
            "part_of",
            "flows_to",
            "causes",
            "manifests_as",
            "treated_by",
            "acts_on",
            "caution_in",
            "complication"
          ]
        },
        "target": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "why": { "type": "string", "minLength": 20, "maxLength": 300 },
        "citations": { "$ref": "#/definitions/citationIds" }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "credential", "role", "date"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "credential": { "type": "string", "minLength": 2 },
        "role": { "enum": ["nurse-educator", "cardiology-clinician"] },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "draftedBy", "reviewers"],
      "properties": {
        "status": { "enum": ["draft", "reviewed"] },
        "draftedBy": { "type": "string", "minLength": 2 },
        "reviewers": { "type": "array", "items": { "$ref": "#/definitions/reviewer" } },
        "nextReviewDue": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      },
      "if": { "properties": { "status": { "const": "reviewed" } } },
      "then": {
        "required": ["nextReviewDue"],
        "properties": { "reviewers": { "type": "array", "minItems": 2 } }
      }
    }
  }
}
